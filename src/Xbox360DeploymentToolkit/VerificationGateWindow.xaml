<Window x:Class="Xbox360DeploymentToolkit.VerificationGateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Confirmación requerida" Width="650" Height="470" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F7F7F7">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="RGH todavía no está verificado" FontSize="24" FontWeight="SemiBold"/><TextBlock Margin="0,14" TextWrapping="Wrap" FontSize="14" Text="Puedes seguir preparando requisitos sin escribir en la consola. Antes de continuar, elige cómo quieres tratar esta condición."/><Border Padding="14" Background="#FFF4CE" Margin="0,6,0,14"><TextBlock TextWrapping="Wrap" Text="Verificación segura: intenta arrancar XeLL con Eject y registra CPU Key/kernel; si XeLL no está disponible, analiza un flash dump con CPU Key en J-Runner. En esta fase no flashes ni escribas la NAND."/></Border><TextBlock TextWrapping="Wrap" Foreground="#9C2D00" Text="Continuar bajo responsabilidad mantendrá dry-run y registrará que la consola no fue verificada. No equivale a confirmar que RGH funciona."/></StackPanel><StackPanel Grid.Row="1"><Button Content="Verificar de forma segura" Padding="18,10" Click="Safe_Click" Background="#107C10" Foreground="White"/><Button Content="Continuar bajo mi responsabilidad" Padding="18,10" Click="Risk_Click"/><Button Content="Volver sin avanzar" Padding="18,10" Click="Back_Click"/></StackPanel></Grid>
</Window>
