<Window x:Class="Xbox360DeploymentToolkit.DeploymentWizardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Asistente de deployment" Width="940" Height="690" MinWidth="820" MinHeight="600" WindowStartupLocation="CenterOwner" Background="#F5F5F5">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#151515" Padding="20"><StackPanel><TextBlock Text="Configuración inicial" Foreground="White" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="No asumiremos nada: primero conoceremos tu consola y el alcance real." Foreground="#CCCCCC"/></StackPanel></Border>
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StepStatus" VerticalAlignment="Center" Foreground="#555"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BackButton" Content="Atrás" Click="Back_Click"/><Button x:Name="NextButton" Content="Siguiente" Click="Next_Click"/><Button x:Name="FinishButton" Content="Guardar plan" Click="Finish_Click" Visibility="Collapsed" Background="#107C10" Foreground="White"/></StackPanel></Grid></Border>
    <TabControl x:Name="WizardTabs" Margin="12" SelectionChanged="WizardTabs_SelectionChanged">
      <TabItem Header="Bienvenida"><Grid Margin="24"><StackPanel VerticalAlignment="Center"><TextBlock Text="Bienvenido a Xbox360 Deployment Toolkit" FontSize="28" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Margin="40,18" TextWrapping="Wrap" TextAlignment="Center" FontSize="15" Text="Este asistente evaluará si el toolkit puede ayudarte, preparará un plan desde cero o adaptado a lo que ya tiene la consola y organizará las carpetas para tus archivos. No proveemos juegos, DLC ni material protegido: ayudamos a que tus propios archivos y decisiones queden documentados y bien organizados."/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Comenzar con el deployment" Padding="24,12" Click="Start_Click" Background="#107C10" Foreground="White"/><Button Content="Explorar la aplicación" Padding="24,12" Click="Explore_Click"/></StackPanel></StackPanel></Grid></TabItem>
      <TabItem Header="Consola"><ScrollViewer><StackPanel Margin="20"><TextBlock Text="1. Conozcamos la consola RGH" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="No necesitamos conocer chip, cableado ni variante exacta. Confirmaremos que ejecuta software modificado y registraremos kernel/NAND para adaptar el procedimiento." Margin="0,5,0,15" TextWrapping="Wrap"/><TextBlock Text="Modelo"/><ComboBox x:Name="ConsoleModelBox" SelectedIndex="0"><ComboBoxItem Content="Sin confirmar"/><ComboBoxItem Content="Xbox 360 Fat"/><ComboBoxItem Content="Xbox 360 Slim"/><ComboBoxItem Content="Xbox 360 E"/></ComboBox><TextBlock Text="Capacidad del almacenamiento interno" Margin="4,10,0,0"/><ComboBox x:Name="InternalCapacityBox" SelectedIndex="0"><ComboBoxItem Content="Sin confirmar"/><ComboBoxItem Content="4 GB"/><ComboBoxItem Content="20 GB"/><ComboBoxItem Content="60 GB"/><ComboBoxItem Content="120 GB"/><ComboBoxItem Content="250 GB"/><ComboBoxItem Content="320 GB"/><ComboBoxItem Content="500 GB"/><ComboBoxItem Content="Otra"/></ComboBox><TextBlock Text="¿Cómo confirmamos que tiene RGH/JTAG funcional?" Margin="4,10,0,0"/><ComboBox x:Name="RghConfirmationBox" SelectedIndex="0"><ComboBoxItem Content="Sin confirmar: se requiere auditoría"/><ComboBoxItem Content="Confirmado: arranca XeLL con Eject"/><ComboBoxItem Content="Confirmado: ejecuta Aurora/XeXMenu/homebrew"/><ComboBoxItem Content="Pendiente: analizar NAND + CPU Key"/><ComboBoxItem Content="No ejecuta XeLL ni homebrew"/></ComboBox><TextBlock Text="Versión de kernel/dashboard (ejemplo: 17559)" Margin="4,10,0,0"/><TextBox x:Name="KernelVersionBox" Text="Sin confirmar"/><TextBlock Text="Disponibilidad de NAND" Margin="4,10,0,0"/><ComboBox x:Name="NandStatusBox" SelectedIndex="0"><ComboBoxItem Content="No disponible"/><ComboBoxItem Content="Flash dump y CPU Key disponibles"/><ComboBoxItem Content="Solo CPU Key disponible"/><ComboBoxItem Content="Se obtendrá desde XeLL en modo lectura"/></ComboBox><TextBlock Text="Subtipo físico (opcional; no bloquea el deployment)" Margin="4,10,0,0"/><ComboBox x:Name="HackTypeBox" SelectedIndex="0"><ComboBoxItem Content="RGH/JTAG — subtipo no necesario"/><ComboBoxItem Content="RGH con chip — detalle no confirmado"/><ComboBoxItem Content="RGH sin chip — detalle no confirmado"/><ComboBoxItem Content="JTAG conocido"/></ComboBox><TextBlock Text="Estado de Xbox Live" Margin="4,10,0,0"/><ComboBox x:Name="LiveStatusBox" SelectedIndex="0"><ComboBoxItem Content="Sin confirmar / no se conectará"/><ComboBoxItem Content="No baneada"/><ComboBoxItem Content="Baneada"/></ComboBox><Border x:Name="CompatibilityBanner" Margin="4,16" Padding="12" Background="#FFF4CE"><TextBlock x:Name="CompatibilityText" TextWrapping="Wrap" Text="El kernel adapta compatibilidad; la confirmación de RGH proviene de XeLL/homebrew o del análisis de NAND."/></Border></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Alcance"><StackPanel Margin="20"><TextBlock Text="2. Tipo de deployment" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Elige el punto de partida real." Margin="0,5,0,15"/><ComboBox x:Name="InstallationModeBox" SelectedIndex="0" SelectionChanged="InstallationMode_Changed"><ComboBoxItem Content="Instalación limpia"/><ComboBoxItem Content="Migración de dashboard o almacenamiento"/><ComboBoxItem Content="Reparación / completar instalación existente"/><ComboBoxItem Content="Solo auditoría y reporte"/></ComboBox><TextBlock x:Name="ExistingLabel" Text="¿Con qué cuenta ya la consola?" Margin="4,18,0,0"/><TextBox x:Name="ExistingComponentsBox" Height="130" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Ejemplo: Aurora instalado, XeXMenu funciona, HDD con Games y Content"/><Border Margin="4,16" Padding="12" Background="#E8F3FF"><TextBlock x:Name="ModeExplanation" TextWrapping="Wrap" Text="Instalación limpia: se generará el procedimiento completo desde auditoría y respaldo hasta pruebas finales."/></Border></StackPanel></TabItem>
      <TabItem Header="Almacenamiento"><ScrollViewer><StackPanel Margin="20"><TextBlock Text="3. Almacenamiento" FontSize="21" FontWeight="SemiBold"/><CheckBox x:Name="UseUsbCheck" Content="Usaré una USB de staging/prueba" IsChecked="True" Margin="4,14"/><TextBlock Text="Capacidad USB (GB). Recomendación del toolkit: 16 GB o más para herramientas y transferencias de prueba; no es un requisito técnico universal." TextWrapping="Wrap"/><TextBox x:Name="UsbCapacityBox" Text="16" Width="150" HorizontalAlignment="Left"/><CheckBox x:Name="UseExternalCheck" Content="También usaré HDD/SSD externo" Margin="4,14"/><TextBox x:Name="ExternalCapacityBox" ToolTip="Ejemplo: 1 TB"/><CheckBox x:Name="UsePcCheck" Content="Mantendré biblioteca y respaldos en esta PC" IsChecked="True" Margin="4,14"/><DockPanel><Button Content="Elegir carpeta en PC" Click="ChoosePcFolder_Click" DockPanel.Dock="Right"/><TextBox x:Name="PcLibraryPathBox"/></DockPanel><Border Margin="4,16" Padding="12" Background="#FFF4CE"><TextBlock TextWrapping="Wrap" Text="La PC es la ubicación recomendada para respaldo maestro y staging. La USB se usa para pruebas y primeros archivos; un HDD/SSD externo es opcional para biblioteca adicional. Ninguna unidad será formateada por el asistente."/></Border></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Componentes"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="4. Componentes y fuentes" FontSize="21" FontWeight="SemiBold"/><DataGrid Grid.Row="1" x:Name="ComponentsGrid" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns><DataGridCheckBoxColumn Header="Usar" Binding="{Binding Selected}" Width="55"/><DataGridCheckBoxColumn Header="Requerido" Binding="{Binding Required}" IsReadOnly="True" Width="75"/><DataGridTextColumn Header="Componente" Binding="{Binding Name}" IsReadOnly="True" Width="150"/><DataGridTextColumn Header="Propósito" Binding="{Binding Purpose}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Fuente evaluada" Binding="{Binding SourceLabel}" IsReadOnly="True" Width="210"/><DataGridTextColumn Header="Compatibilidad" Binding="{Binding CompatibilityNote}" IsReadOnly="True" Width="2*"/><DataGridTextColumn Header="Archivo aportado" Binding="{Binding LocalFile}" Width="220"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="2"><Button Content="Abrir fuente seleccionada" Click="OpenSource_Click"/><Button Content="Elegir archivo propio" Click="ChooseComponentFile_Click"/><TextBlock VerticalAlignment="Center" Margin="12" Text="Los enlaces solo se habilitan cuando existe una fuente verificable."/></WrapPanel></Grid></TabItem>
      <TabItem Header="Juegos"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="5. Juegos que se organizarán" FontSize="21" FontWeight="SemiBold"/><TextBlock TextWrapping="Wrap" Margin="0,4,0,10" Text="Selecciona títulos conocidos o agrega uno manualmente. Solo se crearán carpetas y manifiestos; el usuario aporta sus archivos. El toolkit no provee ni busca juegos o DLC."/></StackPanel><DataGrid Grid.Row="1" x:Name="GamesGrid" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns><DataGridCheckBoxColumn Header="Agregar" Binding="{Binding Selected}" Width="65"/><DataGridTextColumn Header="Título" Binding="{Binding Title}" IsReadOnly="True" Width="240"/><DataGridTextColumn Header="Estructura" Binding="{Binding Layout}" IsReadOnly="True" Width="130"/><DataGridTextColumn Header="Carpeta" Binding="{Binding FolderName}" IsReadOnly="True" Width="190"/><DataGridTextColumn Header="Nota" Binding="{Binding Note}" IsReadOnly="True" Width="*"/></DataGrid.Columns></DataGrid><DockPanel Grid.Row="2"><Button Content="Agregar título personalizado" Click="AddCustomGame_Click" DockPanel.Dock="Right"/><TextBox x:Name="CustomGameBox" ToolTip="Escribe el título"/></DockPanel></Grid></TabItem>
      <TabItem Header="Resumen"><ScrollViewer><StackPanel Margin="20"><TextBlock Text="6. Revisión y plan" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="SummaryText" Margin="0,14" TextWrapping="Wrap" FontFamily="Consolas"/><Border Padding="12" Background="#E8F3FF"><TextBlock TextWrapping="Wrap" Text="Al guardar, el perfil quedará en los datos locales de la app. Si elegiste una biblioteca de PC, se pedirá confirmación antes de crear la estructura y las carpetas de juegos. No se copiará contenido ni se modificará la consola."/></Border></StackPanel></ScrollViewer></TabItem>
    </TabControl>
  </DockPanel>
</Window>
