<Window x:Class="Xbox360DeploymentToolkit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Xbox360 Deployment Toolkit" Width="1180" Height="760" MinWidth="900" MinHeight="620" Background="#F5F5F5">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#151515" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Xbox360 Deployment Toolkit" Foreground="White" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Asistente local para despliegues RGH responsables" Foreground="#BBBBBB"/></StackPanel><CheckBox Grid.Column="1" Content="Modo simulación (dry-run)" IsChecked="{Binding DryRun}" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid></Border>
    <StatusBar DockPanel.Dock="Bottom"><StatusBarItem><TextBlock Text="{Binding Status}"/></StatusBarItem><Separator/><StatusBarItem><ProgressBar Width="180" Height="14" Minimum="0" Maximum="100" Value="{Binding Progress}"/></StatusBarItem></StatusBar>
    <TabControl Margin="12">
      <TabItem Header="Preparación"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel><Button Content="Guardar progreso" Command="{Binding SaveProgressCommand}"/><ProgressBar Width="260" Height="18" Margin="12" Minimum="0" Maximum="100" Value="{Binding PreparationProgress, Mode=OneWay}"/><TextBlock VerticalAlignment="Center" Text="{Binding PreparationProgress, Mode=OneWay, StringFormat={}{0:F0}% preparado}"/><TextBlock Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#9C2D00" Text="La app guía y valida; no descarga contenido automáticamente."/></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding PreparationItems}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns><DataGridCheckBoxColumn Header="Listo" Binding="{Binding IsReady, UpdateSourceTrigger=PropertyChanged}" Width="55"/><DataGridCheckBoxColumn Header="Requerido" Binding="{Binding Required}" IsReadOnly="True" Width="75"/><DataGridTextColumn Header="Categoría" Binding="{Binding Category}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="Qué necesitas" Binding="{Binding Name}" IsReadOnly="True" Width="210"/><DataGridTextColumn Header="Para qué sirve" Binding="{Binding Purpose}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Cómo obtenerlo" Binding="{Binding SourceGuidance}" IsReadOnly="True" Width="2*"/><DataGridTextColumn Header="Destino" Binding="{Binding Destination}" IsReadOnly="True" Width="190"/><DataGridTextColumn Header="Notas" Binding="{Binding Notes}" Width="180"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="Procedimiento"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel><Button Content="Guardar progreso" Command="{Binding SaveProgressCommand}"/><Button Content="Exportar reporte" Command="{Binding ExportCommand}"/><ProgressBar Width="260" Height="18" Margin="12" Minimum="0" Maximum="100" Value="{Binding ChecklistProgress, Mode=OneWay}"/><TextBlock VerticalAlignment="Center" Text="{Binding ChecklistProgress, Mode=OneWay, StringFormat={}{0:F0}% completado}"/></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Steps}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns><DataGridCheckBoxColumn Header="Hecho" Binding="{Binding IsComplete, UpdateSourceTrigger=PropertyChanged}" Width="65"/><DataGridTextColumn Header="Fase" Binding="{Binding Phase}" IsReadOnly="True" Width="130"/><DataGridTextColumn Header="Paso" Binding="{Binding Title}" IsReadOnly="True" Width="220"/><DataGridTextColumn Header="Instrucciones" Binding="{Binding Instructions}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Advertencia" Binding="{Binding Warning}" IsReadOnly="True" Width="220"/><DataGridTextColumn Header="Notas" Binding="{Binding Notes}" Width="220"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="HDD / USB"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="Actualizar unidades" Command="{Binding RefreshDrivesCommand}"/><Button Content="Elegir carpeta raíz" Command="{Binding ChooseRootCommand}"/><TextBox Width="500" Text="{Binding LocalRoot, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Unidad" Binding="{Binding Name}"/><DataGridTextColumn Header="Etiqueta" Binding="{Binding Label}"/><DataGridTextColumn Header="Formato" Binding="{Binding Format}"/><DataGridTextColumn Header="Total (bytes)" Binding="{Binding TotalBytes, StringFormat=N0}" Width="*"/><DataGridTextColumn Header="Libre (bytes)" Binding="{Binding FreeBytes, StringFormat=N0}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2"><TextBlock Text="Crea únicamente: Aurora, Games, Content, Emulators, Homebrew y Compatibility. No formatea ni borra archivos." Foreground="#9C2D00" Margin="4"/><Button Content="Preparar estructura" HorizontalAlignment="Left" Command="{Binding PrepareCommand}"/></StackPanel></Grid></TabItem>
      <TabItem Header="FTP"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><TextBlock Text="Host" VerticalAlignment="Center"/><TextBox Width="150" Text="{Binding Host}"/><TextBlock Text="Usuario" VerticalAlignment="Center"/><TextBox Width="110" Text="{Binding Username}"/><TextBlock Text="Contraseña" VerticalAlignment="Center"/><TextBox Width="110" Text="{Binding Password}"/><CheckBox Content="Recordar protegido en Windows" IsChecked="{Binding RememberCredential}" VerticalAlignment="Center"/></WrapPanel><WrapPanel Grid.Row="1"><TextBlock Text="Ruta remota" VerticalAlignment="Center"/><TextBox Width="330" Text="{Binding FtpPath}"/><Button Content="Conectar / listar" Command="{Binding BrowseFtpCommand}"/></WrapPanel><DataGrid Grid.Row="2" ItemsSource="{Binding FtpEntries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Carpeta" Binding="{Binding IsDirectory}"/><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Ruta" Binding="{Binding FullPath}" Width="2*"/><DataGridTextColumn Header="Tamaño" Binding="{Binding Size, StringFormat=N0}"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="3"><Button Content="Elegir archivo" Command="{Binding ChooseUploadCommand}"/><TextBox Width="500" Text="{Binding UploadFile}"/><Button Content="Subir" Command="{Binding UploadCommand}"/><Button Content="Verificar tamaño" Command="{Binding VerifyUploadCommand}"/></WrapPanel></Grid></TabItem>
      <TabItem Header="Juegos"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><WrapPanel><Button Content="Validar archivos locales" Command="{Binding ValidateGamesCommand}"/><TextBlock Text="Usa la raíz local definida en HDD / USB. Los manifiestos son editables en Configuration/games.json." VerticalAlignment="Center" Margin="12"/></WrapPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Título" Binding="{Binding Title}" IsReadOnly="True" Width="220"/><DataGridTextColumn Header="Tipo" Binding="{Binding Type}" IsReadOnly="True" Width="130"/><DataGridTextColumn Header="Estado (editable)" Binding="{Binding State}" Width="150"/><DataGridTextColumn Header="Validación" Binding="{Binding Validation}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Notas" Binding="{Binding Notes}" IsReadOnly="True" Width="2*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="Auditoría"><DataGrid Margin="12" ItemsSource="{Binding Audit}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Timestamp}" Width="170"/><DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="140"/><DataGridTextColumn Header="Evento" Binding="{Binding Message}" Width="*"/><DataGridTextColumn Header="Resultado" Binding="{Binding Result}" Width="120"/></DataGrid.Columns></DataGrid></TabItem>
    </TabControl>
  </DockPanel>
</Window>
