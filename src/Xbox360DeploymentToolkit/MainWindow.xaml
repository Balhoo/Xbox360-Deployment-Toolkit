<Window x:Class="Xbox360DeploymentToolkit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:xdt="clr-namespace:Xbox360DeploymentToolkit.Presentation.DesignSystem.Controls" Title="Xbox360 Deployment Toolkit" Width="{StaticResource Xdt.Window.Welcome.Width}" Height="{StaticResource Xdt.Window.Welcome.Height}" MinWidth="{StaticResource Xdt.Window.Welcome.Width}" MinHeight="{StaticResource Xdt.Window.Welcome.Height}" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="{StaticResource Xdt.Size.TopBar}" ResizeBorderThickness="8" CornerRadius="{StaticResource Xdt.Radius.Large}" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <TabControl x:Name="RootPages" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}">
    <TabItem>
      <local:WelcomeView xmlns:local="clr-namespace:Xbox360DeploymentToolkit" x:Name="WelcomePage" />
    </TabItem>
    <TabItem>
      <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="{StaticResource Xdt.Grid.TopBar}" />
          <RowDefinition />
          <RowDefinition Height="{StaticResource Xdt.Grid.StatusBar}" />
        </Grid.RowDefinitions>
        <!-- Application title bar -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="32" Height="32" CornerRadius="{StaticResource Xdt.Radius.Medium}" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                <TextBlock Text="XDT" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel>
                <TextBlock Text="Xbox360 Deployment Toolkit" FontWeight="SemiBold" />
                  <TextBlock Text="v0.4" Style="{StaticResource Caption}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <xdt:XdtStatusBadge Content="●  Console: sin conectar" Variant="Offline" Margin="0,0,8,0" />
              <xdt:XdtStatusBadge Content="{Binding FtpConnectionStatus, StringFormat=●  FTP: {0}}" Variant="Pending" />
              <Button Content="" FontFamily="{StaticResource Xdt.Font.Icons}" Style="{StaticResource GhostButton}" Width="40" Padding="0" Margin="16,0,0,0" Tag="8" Click="QuickNavigate_Click" ToolTip="Configuración" />
              <Border Width="32" Height="32" CornerRadius="{StaticResource Xdt.Radius.Pill}" Background="{StaticResource ElevatedBrush}" Margin="8,0">
                <TextBlock Text="A" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button Content="—" Style="{StaticResource WindowCaptionButton}" Click="Minimize_Click" />
              <Button Content="□" Style="{StaticResource WindowCaptionButton}" Click="Maximize_Click" />
              <Button Content="×" Style="{StaticResource WindowCloseButton}" Click="WindowClose_Click" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource Xdt.Grid.Sidebar.Expanded}" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <!-- Sidebar -->
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Margin="24">
                <TextBlock Text="XDT" Style="{StaticResource PageTitle}" Foreground="{StaticResource SuccessBrush}" />
                <TextBlock Text="DEPLOYMENT WORKSPACE" Style="{StaticResource Caption}" />
              </StackPanel>
              <StackPanel Grid.Row="1">
                <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="True" Tag="0" Checked="Navigation_Checked">
                  <TextBlock>
                    <Run FontFamily="{StaticResource Xdt.Font.Icons}" Text="  " />
                    <Run Text="Home" />
                  </TextBlock>
                </RadioButton>
                <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Tag="1" Checked="Navigation_Checked">
                  <TextBlock>
                    <Run FontFamily="{StaticResource Xdt.Font.Icons}" Text="  " />
                    <Run Text="Preparación" />
                  </TextBlock>
                </RadioButton>
                <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Tag="2" Checked="Navigation_Checked" IsEnabled="{Binding IsPreparationComplete}" ToolTip="Completa la preparación obligatoria para desbloquear Deployment">
                  <TextBlock>
                    <Run FontFamily="{StaticResource Xdt.Font.Icons}" Text="  " />
                    <Run Text="Deployment" />
                  </TextBlock>
                </RadioButton>
                <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Tag="5" Checked="Navigation_Checked">
                  <TextBlock>
                    <Run FontFamily="{StaticResource Xdt.Font.Icons}" Text="  " />
                    <Run Text="Contenido" />
                  </TextBlock>
                </RadioButton>
                <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Tag="6" Checked="Navigation_Checked">
                  <TextBlock>
                    <Run FontFamily="{StaticResource Xdt.Font.Icons}" Text="  " />
                    <Run Text="Validación" />
                  </TextBlock>
                </RadioButton>
                <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Tag="7" Checked="Navigation_Checked">
                  <TextBlock>
                    <Run FontFamily="{StaticResource Xdt.Font.Icons}" Text="  " />
                    <Run Text="Reportes" />
                  </TextBlock>
                </RadioButton>
                <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Tag="8" Checked="Navigation_Checked">
                  <TextBlock>
                    <Run FontFamily="{StaticResource Xdt.Font.Icons}" Text="  " />
                    <Run Text="Configuración" />
                  </TextBlock>
                </RadioButton>
              </StackPanel>
              <Border Grid.Row="2" Margin="16" Padding="16" Background="{StaticResource ElevatedBrush}" CornerRadius="{StaticResource Xdt.Radius.Large}">
                <StackPanel>
                  <TextBlock Text="Sesión local" FontWeight="SemiBold" />
                  <TextBlock Text="Sin conexión externa requerida" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          <!-- Workspace -->
          <TabControl x:Name="PageTabs" Grid.Column="1" SelectedIndex="0" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}">
            <!-- Dashboard -->
            <TabItem>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="{StaticResource Xdt.Page.Padding}">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="Home" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Resumen operativo del deployment." Style="{StaticResource PageSubtitle}" />
                  </StackPanel>
                  <UniformGrid Grid.Row="1" Columns="3">
                    <xdt:XdtCard CardType="Status" Margin="0,0,16,16">
                      <StackPanel>
                        <TextBlock Text="Console" Style="{StaticResource Caption}" />
                        <TextBlock Text="Xbox 360 RGH" Style="{StaticResource CardTitle}" Margin="0,12,0,4" />
                        <xdt:XdtStatusBadge Content="● Sin conectar" Variant="Offline" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding Host}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                      </StackPanel>
                    </xdt:XdtCard>
                    <xdt:XdtCard CardType="Metric" Margin="0,0,16,16">
                      <StackPanel>
                        <TextBlock Text="Storage" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Drives.Count}" Style="{StaticResource MetricValue}" Margin="0,12,0,4" />
                        <TextBlock Text="unidades detectadas" Style="{StaticResource PageSubtitle}" />
                        <xdt:XdtButton Content="Abrir almacenamiento" Variant="Secondary" HorizontalAlignment="Center" Tag="3" Click="QuickNavigate_Click" Margin="0,12,0,0" />
                      </StackPanel>
                    </xdt:XdtCard>
                    <xdt:XdtCard CardType="Progress" Margin="0,0,0,16">
                      <StackPanel>
                        <TextBlock Text="Deployment" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding ChecklistProgress, StringFormat={}{0:F0}%}" Style="{StaticResource MetricValue}" Margin="0,12,0,8" />
                        <ProgressBar Value="{Binding ChecklistProgress, Mode=OneWay}" />
                        <TextBlock Text="progreso general" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                      </StackPanel>
                    </xdt:XdtCard>
                  </UniformGrid>
                  <UniformGrid Grid.Row="2" Columns="3">
                    <xdt:XdtCard CardType="Status" Margin="0,0,16,16">
                      <StackPanel>
                        <TextBlock Text="Current Phase" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding SelectedStep.Title, TargetNullValue=Preparación inicial}" Style="{StaticResource CardTitle}" Margin="0,12,0,4" />
                        <TextBlock Text="{Binding SelectedStep.Phase, TargetNullValue=Pendiente}" Style="{StaticResource PageSubtitle}" />
                        <xdt:XdtButton Content="Abrir deployment" Variant="Primary" HorizontalAlignment="Center" IsEnabled="{Binding IsPreparationComplete}" Tag="2" Click="QuickNavigate_Click" Margin="0,16,0,0" />
                      </StackPanel>
                    </xdt:XdtCard>
                    <xdt:XdtCard CardType="Progress" Margin="0,0,16,16">
                      <StackPanel>
                        <TextBlock Text="Transfer Queue" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding FtpConnectionStatus}" Style="{StaticResource CardTitle}" Margin="0,12,0,8" />
                        <ProgressBar Value="{Binding Progress}" />
                        <xdt:XdtButton Content="Abrir FTP" Variant="Secondary" HorizontalAlignment="Center" Tag="4" Click="QuickNavigate_Click" Margin="0,16,0,0" />
                      </StackPanel>
                    </xdt:XdtCard>
                    <xdt:XdtCard CardType="Warning" Margin="0,0,0,16">
                      <StackPanel>
                        <TextBlock Text="Warnings" Style="{StaticResource Caption}" />
                        <TextBlock Text="Modo simulación activo" Style="{StaticResource CardTitle}" Margin="0,12,0,4" />
                        <TextBlock Text="Las operaciones sensibles requieren confirmación explícita." Style="{StaticResource PageSubtitle}" />
                        <xdt:XdtButton Content="Revisar configuración" Variant="Secondary" HorizontalAlignment="Center" Tag="8" Click="QuickNavigate_Click" Margin="0,16,0,0" />
                      </StackPanel>
                    </xdt:XdtCard>
                  </UniformGrid>
                  <xdt:XdtCard Grid.Row="3" CardType="Status">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Activity" Style="{StaticResource CardTitle}" />
                        <ItemsControl ItemsSource="{Binding Audit}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="160" />
                                  <ColumnDefinition />
                                  <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Timestamp}" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="1" Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" />
                                <TextBlock Grid.Column="2" Text="{Binding Result}" Foreground="{StaticResource SecondaryTextBrush}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <Button Content="Validar archivos" Command="{Binding ValidateGamesCommand}" Margin="16,0,0,8" />
                        <Button Content="Exportar reporte" Command="{Binding ExportCommand}" Margin="16,0,0,8" />
                        <Button Content="Abrir o continuar asistente" Click="OpenWizard_Click" Margin="16,0,0,0" />
                      </StackPanel>
                    </Grid>
                  </xdt:XdtCard>
                </Grid>
              </ScrollViewer>
            </TabItem>
            <!-- Preparation -->
            <TabItem>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="{StaticResource Xdt.Page.Padding}">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                  </Grid.RowDefinitions>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Preparación" Style="{StaticResource PageTitle}" />
                      <TextBlock Text="Deja lista la auditoría, los respaldos, el almacenamiento y todos los archivos antes de comenzar." Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <xdt:XdtButton Grid.Column="1" Content="Abrir o continuar asistente" Variant="Secondary" Click="OpenWizard_Click" />
                  </Grid>
                  <xdt:XdtCard Grid.Row="1" CardType="Progress" Margin="0,24,0,16">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="320" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Progreso de preparación" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding PreparationProgress, StringFormat={}{0:F0}% completado}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
                      </StackPanel>
                      <ProgressBar Grid.Column="1" Value="{Binding PreparationProgress, Mode=OneWay}" VerticalAlignment="Center" />
                    </Grid>
                  </xdt:XdtCard>
                  <Border Grid.Row="2" Style="{StaticResource InfoBanner}" Margin="0,0,0,16">
                    <TextBlock Text="XDT no proporciona juegos, DLC, firmware ni paquetes. Orienta sobre compatibilidad y organiza los archivos que agregue el usuario." TextWrapping="Wrap" />
                  </Border>
                  <ItemsControl Grid.Row="3" ItemsSource="{Binding PreparationItems}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,16,16" MinHeight="248">
                          <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                  <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                  <Setter Property="BorderThickness" Value="2" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Grid>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition />
                              <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" />
                              <xdt:XdtStatusBadge Grid.Column="1" Content="{Binding Category}" Variant="Pending" Margin="8,0,0,0" />
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,12">
                              <TextBlock Text="{Binding Purpose}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding SourceGuidance}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                              <TextBlock Text="{Binding Destination}" FontFamily="{StaticResource Xdt.Font.Mono}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Destination}" Margin="0,12,0,0" />
                            </StackPanel>
                            <Grid Grid.Row="2">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Notas opcionales" />
                              <xdt:XdtButton Grid.Column="1" Content="COMPLETAR" Variant="Primary" Command="{Binding DataContext.CompletePreparationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="8,4,0,8">
                                <xdt:XdtButton.Style>
                                  <Style TargetType="xdt:XdtButton" BasedOn="{StaticResource {x:Type xdt:XdtButton}}">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsReady}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </xdt:XdtButton.Style>
                              </xdt:XdtButton>
                              <xdt:XdtStatusBadge Grid.Column="1" Content="Completado" Variant="Completed">
                                <xdt:XdtStatusBadge.Style>
                                  <Style TargetType="xdt:XdtStatusBadge" BasedOn="{StaticResource {x:Type xdt:XdtStatusBadge}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsReady}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </xdt:XdtStatusBadge.Style>
                              </xdt:XdtStatusBadge>
                            </Grid>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </ScrollViewer>
            </TabItem>
            <!-- Deployment -->
            <TabItem>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="{StaticResource Xdt.Page.Padding}">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                  </Grid.RowDefinitions>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Deployment" Style="{StaticResource PageTitle}" />
                      <TextBlock Text="Procedimiento guiado, dependencias, notas y estado por fase." Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <xdt:XdtButton Grid.Column="1" Content="Exportar reporte" Variant="Secondary" Command="{Binding ExportCommand}" />
                  </Grid>
                  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,16">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="260" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Progreso general" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding ChecklistProgress, StringFormat={}{0:F0}% completado}" FontSize="18" FontWeight="SemiBold" />
                      </StackPanel>
                      <ProgressBar Grid.Column="1" Value="{Binding ChecklistProgress, Mode=OneWay}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                  <ItemsControl Grid.Row="2" ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,12">
                          <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                  <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}" />
                                  <Setter Property="BorderThickness" Value="2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                  <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="120" />
                              <ColumnDefinition />
                              <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="{Binding Phase}" Style="{StaticResource Caption}" />
                              <xdt:XdtStatusBadge Content="{Binding Status}" HorizontalAlignment="Left" Margin="0,8,0,0">
                                <xdt:XdtStatusBadge.Style>
                                  <Style TargetType="xdt:XdtStatusBadge" BasedOn="{StaticResource {x:Type xdt:XdtStatusBadge}}">
                                    <Setter Property="Variant" Value="Pending" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Variant" Value="InProgress" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                        <Setter Property="Variant" Value="Completed" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </xdt:XdtStatusBadge.Style>
                              </xdt:XdtStatusBadge>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                              <TextBlock Text="{Binding Instructions}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,24,0" />
                              <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Notas del paso" Margin="0,12,24,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                              <xdt:XdtButton Content="COMPLETAR PASO" Variant="Primary" Command="{Binding DataContext.CompleteStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                <xdt:XdtButton.Style>
                                  <Style TargetType="xdt:XdtButton" BasedOn="{StaticResource {x:Type xdt:XdtButton}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </xdt:XdtButton.Style>
                              </xdt:XdtButton>
                              <TextBlock Text="Bloqueado hasta completar el paso anterior" TextWrapping="Wrap">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                        <Setter Property="Text" Value="Paso verificado" />
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </ScrollViewer>
            </TabItem>
            <!-- Storage -->
            <TabItem>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="24">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                  </Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock Text="Almacenamiento" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Detecta unidades, revisa capacidad y prepara únicamente la estructura autorizada." Style="{StaticResource PageSubtitle}" />
                  </StackPanel>
                  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,16">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Carpeta o unidad de destino" Style="{StaticResource CardTitle}" />
                        <DockPanel>
                          <Button Content="Elegir carpeta" Command="{Binding ChooseRootCommand}" DockPanel.Dock="Right" />
                          <TextBox Text="{Binding LocalRoot}" FontFamily="Cascadia Mono" />
                        </DockPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="OPERACIÓN" Style="{StaticResource Caption}" />
                        <Button Content="Preparar estructura" Command="{Binding PrepareCommand}" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Row="2">
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Unidades detectadas" Style="{StaticResource CardTitle}" />
                      <Button Grid.Column="1" Content="Actualizar" Command="{Binding RefreshDrivesCommand}" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" IsReadOnly="True">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Unidad" Binding="{Binding Name}" Width="90" />
                        <DataGridTextColumn Header="Etiqueta" Binding="{Binding Label}" Width="*" />
                        <DataGridTextColumn Header="Formato" Binding="{Binding Format}" Width="120" />
                        <DataGridTextColumn Header="Capacidad" Binding="{Binding TotalBytes, StringFormat=N0}" Width="160" />
                        <DataGridTextColumn Header="Libre" Binding="{Binding FreeBytes, StringFormat=N0}" Width="160" />
                      </DataGrid.Columns>
                    </DataGrid>
                    <Border Style="{StaticResource WarningBanner}">
                      <TextBlock Text="⚠  Esta operación nunca formatea ni borra: solo crea Aurora, Games, Content, Emulators, Homebrew y Compatibility." />
                    </Border>
                  </StackPanel>
                </Grid>
              </ScrollViewer>
            </TabItem>
            <!-- FTP -->
            <TabItem>
              <Grid Margin="{StaticResource Xdt.Page.Padding}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="Red y FTP" Style="{StaticResource PageTitle}" />
                  <TextBlock Text="Transferencia simple entre staging local y Aurora/XeXMenu." Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <xdt:XdtCard Grid.Row="1" Margin="0,24,0,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="2*" />
                      <ColumnDefinition />
                      <ColumnDefinition />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="HOST" Style="{StaticResource Caption}" />
                      <TextBox Text="{Binding Host}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="USUARIO" Style="{StaticResource Caption}" />
                      <TextBox Text="{Binding Username}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="CONTRASEÑA" Style="{StaticResource Caption}" />
                      <PasswordBox x:Name="FtpPasswordBox" PasswordChanged="FtpPasswordBox_PasswordChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,8">
                      <CheckBox Content="Recordar" IsChecked="{Binding RememberCredential}" />
                      <Button Content="Conectar" Command="{Binding BrowseFtpCommand}" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                  </Grid>
                </xdt:XdtCard>
                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <xdt:XdtCard Margin="0,0,16,0">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Text="LOCAL" Style="{StaticResource CardTitle}" />
                      <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" CornerRadius="{StaticResource Xdt.Radius.Medium}" Padding="16">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding UploadFile}" FontFamily="{StaticResource Xdt.Font.Mono}" TextTrimming="CharacterEllipsis" ToolTip="{Binding UploadFile}" />
                          <TextBlock Text="Archivo propio preparado para transferir." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        </StackPanel>
                      </Border>
                      <Button Grid.Row="2" Content="Elegir archivo" Command="{Binding ChooseUploadCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                    </Grid>
                  </xdt:XdtCard>
                  <xdt:XdtCard Grid.Column="1" CardType="Progress" Margin="0,0,16,0">
                    <StackPanel>
                      <TextBlock Text="QUEUE" Style="{StaticResource CardTitle}" />
                      <TextBlock Text="{Binding Status}" Foreground="{StaticResource SecondaryTextBrush}" />
                      <ProgressBar Value="{Binding Progress}" Margin="0,16,0,8" />
                      <TextBlock Text="{Binding Progress, StringFormat={}{0:F0}%}" Style="{StaticResource Caption}" />
                      <Button Content="Transferir" Command="{Binding UploadCommand}" Style="{StaticResource PrimaryButton}" Margin="0,24,0,8" />
                      <Button Content="Verificar tamaño" Command="{Binding VerifyUploadCommand}" />
                    </StackPanel>
                  </xdt:XdtCard>
                  <xdt:XdtCard Grid.Column="2" Margin="0">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                      </Grid.RowDefinitions>
                      <TextBlock Text="XBOX" Style="{StaticResource CardTitle}" />
                      <TextBox Grid.Row="1" Text="{Binding FtpPath}" FontFamily="{StaticResource Xdt.Font.Mono}" />
                      <DataGrid Grid.Row="2" ItemsSource="{Binding FtpEntries}" IsReadOnly="True">
                        <DataGrid.Columns>
                          <DataGridCheckBoxColumn Header="Dir" Binding="{Binding IsDirectory}" Width="48" />
                          <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" />
                          <DataGridTextColumn Header="Tamaño" Binding="{Binding Size, StringFormat=N0}" Width="120" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </Grid>
                  </xdt:XdtCard>
                </Grid>
              </Grid>
            </TabItem>
            <!-- Games -->
            <TabItem>
              <Grid Margin="{StaticResource Xdt.Page.Padding}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Juegos y contenido" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Selecciona únicamente lo que formará parte del deployment; XDT creará la estructura y mostrará el formato esperado." Style="{StaticResource PageSubtitle}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <xdt:XdtButton Content="Añadir títulos" Variant="Primary" Click="OpenGameCatalog_Click" />
                    <xdt:XdtButton Content="Validar biblioteca" Variant="Secondary" Command="{Binding ValidateGamesCommand}" Margin="8,0,0,0" />
                  </StackPanel>
                </Grid>
                <TabControl Grid.Row="1" x:Name="ContentCategoryTabs" Margin="0,20,0,16">
                  <TabItem Header="XBOX 360" />
                  <TabItem Header="XBOX CLÁSICO" IsEnabled="{Binding IncludeXboxClassic}" />
                  <TabItem Header="EMULADORES" IsEnabled="{Binding IncludeEmulators}" />
                </TabControl>
                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="{StaticResource Xdt.Grid.Inspector}" />
                  </Grid.ColumnDefinitions>
                  <Grid>
                    <TextBlock Text="Todavía no hay títulos seleccionados. Usa Añadir títulos para comenzar." HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=GamesList}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <ListBox x:Name="GamesList" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <xdt:XdtCard CardType="Game" MinHeight="196" Margin="0">
                            <StackPanel>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                <xdt:XdtStatusBadge Grid.Column="1" Content="{Binding Type}" Variant="Pending" />
                              </Grid>
                              <TextBlock Text="{Binding ContentFormat}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,8" />
                              <ProgressBar Value="0" />
                              <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding State}" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="1" Text="Detalles →" Foreground="{StaticResource SuccessBrush}" />
                              </Grid>
                            </StackPanel>
                          </xdt:XdtCard>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                  <xdt:XdtCard Grid.Column="1" Margin="16,0,0,0">
                    <StackPanel>
                      <TextBlock Text="Inspector" Style="{StaticResource Caption}" />
                      <TextBlock Text="{Binding SelectedGame.Title}" Style="{StaticResource CardTitle}" Margin="0,12,0,4" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGame.Title}" />
                      <xdt:XdtStatusBadge Content="{Binding SelectedGame.Type}" Variant="Pending" HorizontalAlignment="Left" />
                      <TextBlock Text="ESTADO" Style="{StaticResource Caption}" Margin="0,24,0,0" />
                      <TextBox Text="{Binding SelectedGame.State}" />
                      <TextBlock Text="VALIDACIÓN" Style="{StaticResource Caption}" />
                      <TextBlock Text="{Binding SelectedGame.Validation}" Margin="0,8,0,16" />
                      <TextBlock Text="FORMATO" Style="{StaticResource Caption}" />
                      <TextBlock Text="{Binding SelectedGame.ContentFormat}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,16" />
                      <TextBlock Text="NOTAS" Style="{StaticResource Caption}" />
                      <TextBlock Text="{Binding SelectedGame.Notes}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,24" />
                      <Button Content="Verificar" Command="{Binding ValidateGamesCommand}" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                  </xdt:XdtCard>
                </Grid>
              </Grid>
            </TabItem>
            <!-- Validation -->
            <TabItem>
              <Grid Margin="24">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Validación y auditoría" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Resultados, advertencias y trazabilidad de la sesión." Style="{StaticResource PageSubtitle}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Ejecutar validación" Command="{Binding ValidateGamesCommand}" Style="{StaticResource PrimaryButton}" />
                </Grid>
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,20,0,8">
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="EVENTOS" Style="{StaticResource Caption}" />
                      <TextBlock Text="{Binding Audit.Count}" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="JUEGOS" Style="{StaticResource Caption}" />
                      <TextBlock Text="{Binding Games.Count}" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="ESTADO" Style="{StaticResource Caption}" />
                      <TextBlock Text="{Binding Status}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>
                </UniformGrid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Audit}" IsReadOnly="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Timestamp}" Width="170" />
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="140" />
                    <DataGridTextColumn Header="Evento" Binding="{Binding Message}" Width="*" />
                    <DataGridTextColumn Header="Resultado" Binding="{Binding Result}" Width="120" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>
            <!-- Reports -->
            <TabItem>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="24">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                  </Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock Text="Reportes" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Exporta evidencia portable de preparación, deployment, juegos y auditoría." Style="{StaticResource PageSubtitle}" />
                  </StackPanel>
                  <UniformGrid Grid.Row="1" Columns="2" Margin="0,20,0,8">
                    <Border Style="{StaticResource Card}">
                      <StackPanel>
                        <TextBlock Text="Reporte de deployment" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Incluye checklist, preparación, catálogo y eventos de sesión." Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button Content="Exportar JSON y CSV" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,20,0,0" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                      <StackPanel>
                        <TextBlock Text="Estado de la sesión" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding Status}" FontSize="16" />
                        <TextBlock Text="Los reportes se guardan en la carpeta local configurada y nunca incluyen credenciales." Style="{StaticResource Caption}" Margin="0,12,0,0" />
                      </StackPanel>
                    </Border>
                  </UniformGrid>
                  <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="Actividad incluida" Style="{StaticResource CardTitle}" />
                      <DataGrid ItemsSource="{Binding Audit}" IsReadOnly="True" MaxHeight="420">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Fecha" Binding="{Binding Timestamp}" Width="170" />
                          <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="140" />
                          <DataGridTextColumn Header="Detalle" Binding="{Binding Message}" Width="*" />
                          <DataGridTextColumn Header="Resultado" Binding="{Binding Result}" Width="120" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </StackPanel>
                  </Border>
                </Grid>
              </ScrollViewer>
            </TabItem>
            <!-- Settings -->
            <TabItem>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="24">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                  </Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock Text="Configuración" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Preferencias de seguridad, sesión y perfil del deployment." Style="{StaticResource PageSubtitle}" />
                  </StackPanel>
                  <Border Grid.Row="1" Style="{StaticResource WarningBanner}" Margin="0,20,0,16">
                    <StackPanel>
                      <TextBlock Text="⚠  Modo simulación" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                      <TextBlock Text="Debe permanecer activo hasta que consola, destino y respaldo estén verificados." Margin="0,6,0,0" />
                      <CheckBox Content="Mantener dry-run activo" IsChecked="{Binding DryRun}" Margin="0,12,0,0" />
                    </StackPanel>
                  </Border>
                  <UniformGrid Grid.Row="2" Columns="2">
                    <Border Style="{StaticResource Card}">
                      <StackPanel>
                        <TextBlock Text="Perfil y onboarding" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Revisa modelo, kernel, NAND, almacenamiento, componentes y juegos seleccionados." Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button Content="Abrir o continuar asistente" Click="OpenWizard_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,20,0,0" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                      <StackPanel>
                        <TextBlock Text="Credenciales FTP" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Se protegen mediante Windows DPAPI para el usuario actual y no aparecen en reportes." Foreground="{StaticResource SecondaryTextBrush}" />
                        <CheckBox Content="Recordar credencial protegida" IsChecked="{Binding RememberCredential}" Margin="0,20,0,0" />
                      </StackPanel>
                    </Border>
                  </UniformGrid>
                </Grid>
              </ScrollViewer>
            </TabItem>
            <!-- Configuration assistant: a regular workspace page -->
            <TabItem>
              <Grid Margin="24">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Asistente de configuración" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Preparación inicial integrada en el workspace." Style="{StaticResource PageSubtitle}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Volver al Dashboard" Click="CloseWizard_Click" />
                </Grid>
                <local:EmbeddedWizardView xmlns:local="clr-namespace:Xbox360DeploymentToolkit" x:Name="DeploymentWizard" Grid.Row="1" Margin="0,24,0,0" />
              </Grid>
            </TabItem>
          </TabControl>
        </Grid>
        <StatusBar Grid.Row="2">
          <StatusBarItem>
            <TextBlock Text="Console  ● Sin conectar" />
          </StatusBarItem>
          <Separator />
          <StatusBarItem>
            <TextBlock Text="{Binding FtpConnectionStatus, StringFormat=FTP  {0}}" />
          </StatusBarItem>
          <Separator />
          <StatusBarItem>
            <TextBlock Text="USB  —" />
          </StatusBarItem>
          <Separator />
          <StatusBarItem>
            <TextBlock Text="HDD  —" />
          </StatusBarItem>
          <Separator />
          <StatusBarItem>
            <TextBlock Text="Warnings  0" Foreground="{StaticResource WarningBrush}" />
          </StatusBarItem>
          <StatusBarItem HorizontalAlignment="Right">
            <TextBlock Text="XDT v0.4" />
          </StatusBarItem>
        </StatusBar>
        <Grid x:Name="GameCatalogOverlay" Grid.RowSpan="3" Background="{StaticResource Xdt.Brush.Overlay}" Visibility="Collapsed" Panel.ZIndex="105">
          <Border Width="920" MaxHeight="720" Padding="24" CornerRadius="{StaticResource Xdt.Radius.Large}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Añadir juegos Xbox 360" Style="{StaticResource PageTitle}"/><TextBlock Text="Selecciona uno o varios títulos. Si no aparece, agrégalo manualmente." Style="{StaticResource PageSubtitle}"/></StackPanel><xdt:XdtButton Grid.Column="1" Content="Cerrar" Variant="Ghost" Click="CloseGameCatalog_Click"/></Grid>
              <ListBox Grid.Row="1" ItemsSource="{Binding GameCatalog}" SelectionMode="Extended" Background="Transparent" BorderThickness="0" Margin="0,20,0,12" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="150"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Selected}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding FormatGuidance}" Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Layout}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding HasDlc, StringFormat=DLC: {0}}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
              <Border Grid.Row="2" Style="{StaticResource ElevatedCard}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Título no incluido" Style="{StaticResource Caption}"/><TextBox x:Name="CustomGameTitleBox" ToolTip="Nombre del juego"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Estructura" Style="{StaticResource Caption}"/><ComboBox x:Name="CustomGameLayoutBox" SelectedIndex="0"><ComboBoxItem Content="SingleDisc"/><ComboBoxItem Content="MultiDisc"/></ComboBox></StackPanel><CheckBox Grid.Column="2" x:Name="CustomGameDlcCheck" Content="Incluye DLC" VerticalAlignment="Center"/><xdt:XdtButton Grid.Column="3" Content="Agregar manual" Variant="Secondary" Click="AddCustomGame_Click" VerticalAlignment="Center"/></Grid></Border>
              <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="XDT creará carpetas vacías y mostrará el formato; no proporciona descargas." Style="{StaticResource Caption}" VerticalAlignment="Center"/><xdt:XdtButton Grid.Column="1" Content="Añadir seleccionados" Variant="Primary" Click="AddSelectedGames_Click"/></Grid>
            </Grid>
          </Border>
        </Grid>
        <Grid x:Name="ConfirmationOverlay" Grid.RowSpan="3" Background="{StaticResource Xdt.Brush.Overlay}" Visibility="Collapsed" Panel.ZIndex="110">
          <Border Width="640" Padding="24" CornerRadius="{StaticResource Xdt.Radius.Large}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" Effect="{StaticResource Xdt.Elevation.Level2}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
              <TextBlock x:Name="ConfirmationTitle" Style="{StaticResource PageTitle}" />
              <TextBlock x:Name="ConfirmationMessage" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,16" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="ConfirmationCancel_Click" />
                <Button Content="Confirmar" Click="ConfirmationAccept_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
        <Border x:Name="Toast" Grid.Row="1" Panel.ZIndex="120" Visibility="Collapsed" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource Xdt.Radius.Medium}" Padding="16" Margin="0,0,24,24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="360" Effect="{StaticResource Xdt.Elevation.Level3}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="ToastTitle" FontWeight="SemiBold" />
              <Button Grid.Column="1" Content="×" Style="{StaticResource GhostButton}" Width="32" Height="32" Padding="0" Click="ToastClose_Click" />
            </Grid>
            <TextBlock x:Name="ToastMessage" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </TabItem>
  </TabControl>
</Window>
