<Window x:Class="Xbox360DeploymentToolkit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Xbox360 Deployment Toolkit" Width="1440" Height="900" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen">
  <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <!-- Application title bar -->
    <Border Grid.Row="0" Background="#101319" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentBrush}" Margin="0,0,10,0"><TextBlock Text="X" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Xbox360 Deployment Toolkit" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border CornerRadius="8" Background="#332E19" Padding="10,5" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="⚠" Foreground="{StaticResource WarningBrush}" Margin="0,0,6,0"/><TextBlock Text="Dry-run" FontWeight="SemiBold"/></StackPanel></Border><TextBlock Text="●" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/><TextBlock Text=" FTP listo para conectar" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/></StackPanel></Grid></Border>

    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <!-- Sidebar -->
      <Border Background="#11151B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="16,20,16,16"><TextBlock Text="XDT" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="DEPLOYMENT WORKSPACE" Style="{StaticResource Caption}"/></StackPanel><StackPanel Grid.Row="1"><RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="True" Tag="0" Checked="Navigation_Checked"><TextBlock><Run Text="⌂  "/><Run Text="Dashboard"/></TextBlock></RadioButton><RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Tag="1" Checked="Navigation_Checked"><TextBlock><Run Text="✓  "/><Run Text="Preparación"/></TextBlock></RadioButton><RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Tag="2" Checked="Navigation_Checked"><TextBlock><Run Text="▷  "/><Run Text="Deployment"/></TextBlock></RadioButton><RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Tag="3" Checked="Navigation_Checked"><TextBlock><Run Text="▣  "/><Run Text="Almacenamiento"/></TextBlock></RadioButton><RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Tag="4" Checked="Navigation_Checked"><TextBlock><Run Text="⇄  "/><Run Text="Red y FTP"/></TextBlock></RadioButton><RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Tag="5" Checked="Navigation_Checked"><TextBlock><Run Text="▤  "/><Run Text="Juegos y contenido"/></TextBlock></RadioButton><RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Tag="6" Checked="Navigation_Checked"><TextBlock><Run Text="◉  "/><Run Text="Validación"/></TextBlock></RadioButton><RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Tag="7" Checked="Navigation_Checked"><TextBlock><Run Text="▧  "/><Run Text="Reportes"/></TextBlock></RadioButton><RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Tag="8" Checked="Navigation_Checked"><TextBlock><Run Text="⚙  "/><Run Text="Configuración"/></TextBlock></RadioButton></StackPanel><Border Grid.Row="2" Margin="16" Padding="12" Background="{StaticResource SurfaceBrush}" CornerRadius="10"><StackPanel><TextBlock Text="Sesión local" FontWeight="SemiBold"/><TextBlock Text="Sin conexión externa requerida" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border></Grid></Border>

      <!-- Workspace -->
      <TabControl x:Name="PageTabs" Grid.Column="1" SelectedIndex="0">
        <!-- Dashboard -->
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel Margin="0,0,0,20"><TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/><TextBlock Text="Estado actual del deployment y accesos operativos." Style="{StaticResource PageSubtitle}"/></StackPanel><UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PREPARACIÓN" Style="{StaticResource Caption}"/><TextBlock Text="{Binding PreparationProgress, StringFormat={}{0:F0}%}" Style="{StaticResource MetricValue}" Margin="0,8,0,8"/><ProgressBar Value="{Binding PreparationProgress, Mode=OneWay}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="DEPLOYMENT" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ChecklistProgress, StringFormat={}{0:F0}%}" Style="{StaticResource MetricValue}" Margin="0,8,0,8"/><ProgressBar Value="{Binding ChecklistProgress, Mode=OneWay}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="UNIDADES" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Drives.Count}" Style="{StaticResource MetricValue}" Margin="0,8,0,0"/><TextBlock Text="detectadas" Style="{StaticResource Caption}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="FTP / SESIÓN" Style="{StaticResource Caption}"/><TextBlock Text="{Binding FtpConnectionStatus}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="{Binding Host}" Style="{StaticResource Caption}"/></StackPanel></Border></UniformGrid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Flujo de trabajo" Style="{StaticResource CardTitle}"/><ItemsControl ItemsSource="{Binding Steps}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource ElevatedBrush}" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Phase}" Style="{StaticResource Caption}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource SecondaryTextBrush}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Abrir deployment" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Tag="2" Click="QuickNavigate_Click"/></StackPanel></Border><StackPanel Grid.Column="1"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Acciones rápidas" Style="{StaticResource CardTitle}"/><Button Content="Explorar FTP" Tag="4" Click="QuickNavigate_Click" HorizontalContentAlignment="Left"/><Button Content="Validar archivos" Command="{Binding ValidateGamesCommand}" HorizontalContentAlignment="Left"/><Button Content="Exportar reporte" Command="{Binding ExportCommand}" HorizontalContentAlignment="Left"/><Button Content="Revisar perfil inicial" Click="OpenWizard_Click" HorizontalContentAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Actividad reciente" Style="{StaticResource CardTitle}"/><ItemsControl ItemsSource="{Binding Audit}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,10"><TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/><TextBlock Text="{Binding Timestamp}" Style="{StaticResource Caption}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></Grid></Grid></ScrollViewer></TabItem>

        <!-- Preparation -->
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Preparación" Style="{StaticResource PageTitle}"/><TextBlock Text="Insumos, hardware y archivos que deben estar disponibles antes de operar." Style="{StaticResource PageSubtitle}"/></StackPanel><Button Grid.Column="1" Content="Guardar progreso" Command="{Binding SaveProgressCommand}" Style="{StaticResource PrimaryButton}"/></Grid><Border Grid.Row="1" Style="{StaticResource InfoBanner}"><TextBlock Text="ⓘ  El toolkit guía y valida. No descarga juegos, DLC, BIOS, ROMs ni software de procedencia no verificada."/></Border><ItemsControl Grid.Row="2" ItemsSource="{Binding PreparationItems}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsReady}" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/><Border Background="{StaticResource ElevatedBrush}" CornerRadius="6" Padding="8,2" Margin="8,0"><TextBlock Text="{Binding Category}" Style="{StaticResource Caption}"/></Border></StackPanel><TextBlock Text="{Binding Purpose}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,16,4"/><TextBlock Text="{Binding SourceGuidance}" Style="{StaticResource Caption}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="DESTINO" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Destination}" FontFamily="Cascadia Mono" TextTrimming="CharacterEllipsis" ToolTip="{Binding Destination}" Margin="0,4,0,8"/><TextBox Text="{Binding Notes}" ToolTip="Notas"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></ScrollViewer></TabItem>

        <!-- Deployment -->
        <TabItem><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Deployment" Style="{StaticResource PageTitle}"/><TextBlock Text="Procedimiento guiado, dependencias, notas y estado por fase." Style="{StaticResource PageSubtitle}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Guardar" Command="{Binding SaveProgressCommand}"/><Button Content="Exportar" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Progreso general" Style="{StaticResource CardTitle}"/><TextBlock Text="{Binding ChecklistProgress, StringFormat={}{0:F0}% completado}" FontSize="18" FontWeight="SemiBold"/></StackPanel><ProgressBar Grid.Column="1" Value="{Binding ChecklistProgress, Mode=OneWay}" VerticalAlignment="Center"/></Grid></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Estado" Binding="{Binding IsComplete}" Width="70"/><DataGridTextColumn Header="Fase" Binding="{Binding Phase}" Width="150"/><DataGridTextColumn Header="Paso" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Resultado" Binding="{Binding Status}" Width="110"/></DataGrid.Columns></DataGrid><Border Grid.Column="1" Style="{StaticResource ElevatedCard}" Margin="16,0,0,0"><StackPanel><TextBlock Text="Inspector del paso" Style="{StaticResource CardTitle}"/><TextBlock Text="{Binding SelectedStep.Title}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedStep.Instructions}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,12"/><Border Style="{StaticResource WarningBanner}"><TextBlock Text="{Binding SelectedStep.Warning}"/></Border><TextBlock Text="NOTAS" Style="{StaticResource Caption}" Margin="0,8,0,0"/><TextBox Text="{Binding SelectedStep.Notes}" Height="110" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel></Border></Grid></Grid></TabItem>

        <!-- Storage -->
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="Almacenamiento" Style="{StaticResource PageTitle}"/><TextBlock Text="Detecta unidades, revisa capacidad y prepara únicamente la estructura autorizada." Style="{StaticResource PageSubtitle}"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Carpeta o unidad de destino" Style="{StaticResource CardTitle}"/><DockPanel><Button Content="Elegir carpeta" Command="{Binding ChooseRootCommand}" DockPanel.Dock="Right"/><TextBox Text="{Binding LocalRoot}" FontFamily="Cascadia Mono"/></DockPanel></StackPanel><StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="OPERACIÓN" Style="{StaticResource Caption}"/><Button Content="Preparar estructura" Command="{Binding PrepareCommand}" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"/></StackPanel></Grid></Border><StackPanel Grid.Row="2"><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Unidades detectadas" Style="{StaticResource CardTitle}"/><Button Grid.Column="1" Content="Actualizar" Command="{Binding RefreshDrivesCommand}"/></Grid><DataGrid ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Unidad" Binding="{Binding Name}" Width="90"/><DataGridTextColumn Header="Etiqueta" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="Formato" Binding="{Binding Format}" Width="120"/><DataGridTextColumn Header="Capacidad" Binding="{Binding TotalBytes, StringFormat=N0}" Width="160"/><DataGridTextColumn Header="Libre" Binding="{Binding FreeBytes, StringFormat=N0}" Width="160"/></DataGrid.Columns></DataGrid><Border Style="{StaticResource WarningBanner}"><TextBlock Text="⚠  Esta operación nunca formatea ni borra: solo crea Aurora, Games, Content, Emulators, Homebrew y Compatibility."/></Border></StackPanel></Grid></ScrollViewer></TabItem>

        <!-- FTP -->
        <TabItem><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Red y FTP" Style="{StaticResource PageTitle}"/><TextBlock Text="Explorador simplificado para staging local y archivos de Aurora/XeXMenu." Style="{StaticResource PageSubtitle}"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="HOST" Style="{StaticResource Caption}"/><TextBox Text="{Binding Host}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="USUARIO" Style="{StaticResource Caption}"/><TextBox Text="{Binding Username}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CONTRASEÑA" Style="{StaticResource Caption}"/><PasswordBox x:Name="FtpPasswordBox" PasswordChanged="FtpPasswordBox_PasswordChanged"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="RUTA XBOX" Style="{StaticResource Caption}"/><TextBox Text="{Binding FtpPath}" FontFamily="Cascadia Mono"/></StackPanel><StackPanel Grid.Column="4" Margin="8,16,0,0" Orientation="Horizontal"><CheckBox Content="Recordar" IsChecked="{Binding RememberCredential}"/><Button Content="Conectar" Command="{Binding BrowseFtpCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Local · archivo de staging" Style="{StaticResource CardTitle}"/><Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="16"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding UploadFile}" FontFamily="Cascadia Mono" TextTrimming="CharacterEllipsis" ToolTip="{Binding UploadFile}"/><TextBlock Text="Selecciona un archivo que tengas autorizado para transferir." Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></Border><Button Grid.Row="2" Content="Elegir archivo" Command="{Binding ChooseUploadCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/></Grid></Border><Border Grid.Column="2" Style="{StaticResource Card}" Margin="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Xbox · ruta remota" Style="{StaticResource CardTitle}"/><DataGrid Grid.Row="1" ItemsSource="{Binding FtpEntries}" IsReadOnly="True"><DataGrid.Columns><DataGridCheckBoxColumn Header="Dir" Binding="{Binding IsDirectory}" Width="50"/><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Tamaño" Binding="{Binding Size, StringFormat=N0}" Width="120"/></DataGrid.Columns></DataGrid></Grid></Border></Grid><Border Grid.Row="3" Style="{StaticResource ElevatedCard}" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Cola de transferencia" Style="{StaticResource CardTitle}"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource SecondaryTextBrush}"/><ProgressBar Value="{Binding Progress}" Margin="0,10,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Transferir" Command="{Binding UploadCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Verificar tamaño" Command="{Binding VerifyUploadCommand}"/></StackPanel></Grid></Border></Grid></TabItem>

        <!-- Games -->
        <TabItem><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Juegos y contenido" Style="{StaticResource PageTitle}"/><TextBlock Text="Organiza títulos, multidisco, DLC y componentes opcionales sin proveer contenido." Style="{StaticResource PageSubtitle}"/></StackPanel><Button Grid.Column="1" Content="Validar biblioteca" Command="{Binding ValidateGamesCommand}" Style="{StaticResource PrimaryButton}"/></Grid><Grid Grid.Row="1" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions><ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="300" Height="170"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/><Border Grid.Column="1" Background="{StaticResource ElevatedBrush}" CornerRadius="6" Padding="8,3"><TextBlock Text="{Binding Type}" Style="{StaticResource Caption}"/></Border></Grid><TextBlock Text="{Binding Validation}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,16,0,6"/><ProgressBar Value="0"/><TextBlock Text="{Binding State}" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Column="1" Style="{StaticResource ElevatedCard}" Margin="16,0,0,0"><StackPanel><TextBlock Text="Inspector de contenido" Style="{StaticResource CardTitle}"/><TextBlock Text="{Binding SelectedGame.Title}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedGame.Type}" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,16"/><TextBlock Text="ESTADO" Style="{StaticResource Caption}"/><TextBox Text="{Binding SelectedGame.State}"/><TextBlock Text="VALIDACIÓN" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedGame.Validation}" Margin="0,6,0,16"/><TextBlock Text="NOTAS" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedGame.Notes}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,16"/><Button Content="Verificar biblioteca" Command="{Binding ValidateGamesCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel></Border></Grid></Grid></TabItem>

        <!-- Validation -->
        <TabItem><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Validación y auditoría" Style="{StaticResource PageTitle}"/><TextBlock Text="Resultados, advertencias y trazabilidad de la sesión." Style="{StaticResource PageSubtitle}"/></StackPanel><Button Grid.Column="1" Content="Ejecutar validación" Command="{Binding ValidateGamesCommand}" Style="{StaticResource PrimaryButton}"/></Grid><UniformGrid Grid.Row="1" Columns="3" Margin="0,20,0,8"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="EVENTOS" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Audit.Count}" Style="{StaticResource MetricValue}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="JUEGOS" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Games.Count}" Style="{StaticResource MetricValue}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ESTADO" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Status}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid><DataGrid Grid.Row="2" ItemsSource="{Binding Audit}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Timestamp}" Width="170"/><DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="140"/><DataGridTextColumn Header="Evento" Binding="{Binding Message}" Width="*"/><DataGridTextColumn Header="Resultado" Binding="{Binding Result}" Width="120"/></DataGrid.Columns></DataGrid></Grid></TabItem>

        <!-- Reports -->
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="Reportes" Style="{StaticResource PageTitle}"/><TextBlock Text="Exporta evidencia portable de preparación, deployment, juegos y auditoría." Style="{StaticResource PageSubtitle}"/></StackPanel><UniformGrid Grid.Row="1" Columns="2" Margin="0,20,0,8"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Reporte de deployment" Style="{StaticResource CardTitle}"/><TextBlock Text="Incluye checklist, preparación, catálogo y eventos de sesión." Foreground="{StaticResource SecondaryTextBrush}"/><Button Content="Exportar JSON y CSV" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Estado de la sesión" Style="{StaticResource CardTitle}"/><TextBlock Text="{Binding Status}" FontSize="16"/><TextBlock Text="Los reportes se guardan en la carpeta local configurada y nunca incluyen credenciales." Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border></UniformGrid><Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Actividad incluida" Style="{StaticResource CardTitle}"/><DataGrid ItemsSource="{Binding Audit}" IsReadOnly="True" MaxHeight="420"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Timestamp}" Width="170"/><DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="140"/><DataGridTextColumn Header="Detalle" Binding="{Binding Message}" Width="*"/><DataGridTextColumn Header="Resultado" Binding="{Binding Result}" Width="120"/></DataGrid.Columns></DataGrid></StackPanel></Border></Grid></ScrollViewer></TabItem>

        <!-- Settings -->
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="Configuración" Style="{StaticResource PageTitle}"/><TextBlock Text="Preferencias de seguridad, sesión y perfil del deployment." Style="{StaticResource PageSubtitle}"/></StackPanel><Border Grid.Row="1" Style="{StaticResource WarningBanner}" Margin="0,20,0,16"><StackPanel><TextBlock Text="⚠  Modo simulación" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/><TextBlock Text="Debe permanecer activo hasta que consola, destino y respaldo estén verificados." Margin="0,6,0,0"/><CheckBox Content="Mantener dry-run activo" IsChecked="{Binding DryRun}" Margin="0,12,0,0"/></StackPanel></Border><UniformGrid Grid.Row="2" Columns="2"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Perfil y onboarding" Style="{StaticResource CardTitle}"/><TextBlock Text="Revisa modelo, kernel, NAND, almacenamiento, componentes y juegos seleccionados." Foreground="{StaticResource SecondaryTextBrush}"/><Button Content="Abrir asistente en el workspace" Click="OpenWizard_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Credenciales FTP" Style="{StaticResource CardTitle}"/><TextBlock Text="Se protegen mediante Windows DPAPI para el usuario actual y no aparecen en reportes." Foreground="{StaticResource SecondaryTextBrush}"/><CheckBox Content="Recordar credencial protegida" IsChecked="{Binding RememberCredential}" Margin="0,20,0,0"/></StackPanel></Border></UniformGrid></Grid></ScrollViewer></TabItem>
      </TabControl>
    </Grid>

    <StatusBar Grid.Row="2"><StatusBarItem><TextBlock Text="●" Foreground="{StaticResource SuccessBrush}"/></StatusBarItem><StatusBarItem><TextBlock Text="{Binding Status}"/></StatusBarItem><Separator/><StatusBarItem><TextBlock Text="Dry-run:"/></StatusBarItem><StatusBarItem><TextBlock Text="{Binding DryRun}"/></StatusBarItem><Separator/><StatusBarItem><TextBlock Text="FTP:"/></StatusBarItem><StatusBarItem><TextBlock Text="{Binding FtpConnectionStatus}"/></StatusBarItem><Separator/><StatusBarItem HorizontalAlignment="Right"><TextBlock Text="XDT v0.2"/></StatusBarItem></StatusBar>

    <!-- In-shell onboarding overlay, populated in the next migration step -->
    <Grid x:Name="WizardOverlay" Grid.RowSpan="3" Background="#D90F1115" Visibility="Collapsed" Panel.ZIndex="100"><Border Width="960" Height="720" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Asistente de deployment" Style="{StaticResource PageTitle}"/><TextBlock Text="Configuración inicial integrada en el workspace." Style="{StaticResource PageSubtitle}"/></StackPanel><Button Grid.Column="1" Content="Cerrar" Click="CloseWizard_Click"/></Grid><ContentControl x:Name="WizardContent" Grid.Row="1" Margin="24,0"/><Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24"><TextBlock Text="Tus respuestas se guardan localmente. Ninguna operación se ejecuta sin confirmación." Style="{StaticResource Caption}"/></Border></Grid></Border></Grid>
    <Grid x:Name="ConfirmationOverlay" Grid.RowSpan="3" Background="#D90F1115" Visibility="Collapsed" Panel.ZIndex="110"><Border Width="620" Padding="24" CornerRadius="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock x:Name="ConfirmationTitle" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ConfirmationMessage" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,16"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Click="ConfirmationCancel_Click"/><Button Content="Confirmar" Click="ConfirmationAccept_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></StackPanel></Border></Grid>
    <Border x:Name="Toast" Grid.Row="1" Panel.ZIndex="120" Visibility="Collapsed" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,20,24,0" HorizontalAlignment="Right" VerticalAlignment="Top" Width="380"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ToastTitle" FontWeight="SemiBold"/><Button Grid.Column="1" Content="×" Padding="6,2" MinHeight="24" Click="ToastClose_Click"/></Grid><TextBlock x:Name="ToastMessage" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0"/></StackPanel></Border>
  </Grid>
