<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:xdt="clr-namespace:Xbox360DeploymentToolkit.Presentation.DesignSystem.Controls">
  <Style x:Key="XdtButtonBase" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Height" Value="{DynamicResource Xdt.Size.Button.Medium}"/><Setter Property="Padding" Value="{DynamicResource Xdt.Control.Padding.Medium}"/><Setter Property="FontSize" Value="{DynamicResource Xdt.FontSize.Body}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Xdt.Radius.Medium}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.68"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/><Setter TargetName="Root" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.40"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource XdtButtonBase}"/>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource XdtButtonBase}"/>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource XdtButtonBase}"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
  <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource XdtButtonBase}"><Setter Property="Background" Value="{DynamicResource SuccessBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/></Style>
  <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource XdtButtonBase}"><Setter Property="Background" Value="{DynamicResource Xdt.Brush.Warning.Subtle}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/></Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource XdtButtonBase}"><Setter Property="Background" Value="{DynamicResource Xdt.Brush.Error.Subtle}"/><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/></Style>
  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource XdtButtonBase}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource XdtButtonBase}"><Setter Property="Background" Value="Transparent"/></Style>
  <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource XdtButtonBase}"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="xdt:XdtButton" BasedOn="{StaticResource XdtButtonBase}">
    <Style.Triggers>
      <Trigger Property="Variant" Value="Primary"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
      <Trigger Property="Variant" Value="Success"><Setter Property="Background" Value="{DynamicResource SuccessBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/></Trigger>
      <Trigger Property="Variant" Value="Warning"><Setter Property="Background" Value="{DynamicResource Xdt.Brush.Warning.Subtle}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/></Trigger>
      <Trigger Property="Variant" Value="Danger"><Setter Property="Background" Value="{DynamicResource Xdt.Brush.Error.Subtle}"/><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/></Trigger>
      <Trigger Property="Variant" Value="Ghost"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Trigger>
      <Trigger Property="Variant" Value="Outline"><Setter Property="Background" Value="Transparent"/></Trigger>
      <Trigger Property="Variant" Value="Text"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Trigger>
      <Trigger Property="ControlSize" Value="Small"><Setter Property="Height" Value="{DynamicResource Xdt.Size.Button.Small}"/><Setter Property="Padding" Value="{DynamicResource Xdt.Control.Padding.Small}"/></Trigger>
      <Trigger Property="ControlSize" Value="Large"><Setter Property="Height" Value="{DynamicResource Xdt.Size.Button.Large}"/><Setter Property="Padding" Value="{DynamicResource Xdt.Control.Padding.Large}"/></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
