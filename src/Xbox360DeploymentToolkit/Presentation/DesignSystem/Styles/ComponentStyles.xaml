<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:xdt="clr-namespace:Xbox360DeploymentToolkit.Presentation.DesignSystem.Controls">
  <Style TargetType="xdt:XdtStatusBadge"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/><Setter Property="Height" Value="{DynamicResource Xdt.Size.Badge}"/><Setter Property="Padding" Value="12,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="xdt:XdtStatusBadge"><Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Xdt.Radius.Pill}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Variant" Value="Success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/><Setter Property="Background" Value="{DynamicResource Xdt.Brush.Accent.Subtle}"/></Trigger><Trigger Property="Variant" Value="Completed"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/><Setter Property="Background" Value="{DynamicResource Xdt.Brush.Accent.Subtle}"/></Trigger><Trigger Property="Variant" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/><Setter Property="Background" Value="{DynamicResource Xdt.Brush.Warning.Subtle}"/></Trigger><Trigger Property="Variant" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/><Setter Property="Background" Value="{DynamicResource Xdt.Brush.Error.Subtle}"/></Trigger><Trigger Property="Variant" Value="InProgress"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/><Setter Property="Background" Value="{DynamicResource Xdt.Brush.Info.Subtle}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="xdt:XdtBanner"><Setter Property="Background" Value="{DynamicResource Xdt.Brush.Info.Subtle}"/><Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="{DynamicResource Xdt.Thickness.16}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="xdt:XdtBanner"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Xdt.Radius.Medium}" Padding="{TemplateBinding Padding}"><StackPanel><TextBlock Text="{TemplateBinding Header}" FontWeight="SemiBold"/><ContentPresenter Margin="0,4,0,0"/></StackPanel></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Variant" Value="Warning"><Setter Property="Background" Value="{DynamicResource Xdt.Brush.Warning.Subtle}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/></Trigger><Trigger Property="Variant" Value="Success"><Setter Property="Background" Value="{DynamicResource Xdt.Brush.Accent.Subtle}"/><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/></Trigger><Trigger Property="Variant" Value="Error"><Setter Property="Background" Value="{DynamicResource Xdt.Brush.Error.Subtle}"/><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/></Trigger></Style.Triggers></Style>
</ResourceDictionary>
