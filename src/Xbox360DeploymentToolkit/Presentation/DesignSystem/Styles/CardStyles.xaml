<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:xdt="clr-namespace:Xbox360DeploymentToolkit.Presentation.DesignSystem.Controls">
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource Xdt.Radius.Large}"/><Setter Property="Padding" Value="{DynamicResource Xdt.Thickness.24}"/><Setter Property="Margin" Value="0,0,16,16"/><Setter Property="Effect" Value="{DynamicResource Xdt.Elevation.Level1}"/></Style>
  <Style x:Key="ElevatedCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/></Style>
  <Style TargetType="xdt:XdtCard"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="{DynamicResource Xdt.Thickness.24}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="xdt:XdtCard"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Xdt.Radius.Large}" Padding="{TemplateBinding Padding}" Effect="{DynamicResource Xdt.Elevation.Level1}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="CardType" Value="Warning"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/></Trigger></Style.Triggers></Style>
</ResourceDictionary>
