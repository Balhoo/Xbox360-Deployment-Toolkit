<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
  <Style x:Key="NavButton" TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="8,2"/><Setter Property="MinHeight" Value="48"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid><Border x:Name="NavRoot" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Xdt.Radius.Medium}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><Border x:Name="ActiveBar" Width="4" Margin="0,8" CornerRadius="2" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavRoot" Property="Background" Value="{DynamicResource ElevatedBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="NavRoot" Property="Background" Value="{DynamicResource ElevatedBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavRoot" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/><Setter TargetName="NavRoot" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
