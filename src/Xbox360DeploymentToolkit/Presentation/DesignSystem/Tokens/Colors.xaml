<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Xdt.Color.Background">#0F1115</Color>
  <Color x:Key="Xdt.Color.Surface">#171A21</Color>
  <Color x:Key="Xdt.Color.Elevated">#20242C</Color>
  <Color x:Key="Xdt.Color.Border">#303640</Color>
  <Color x:Key="Xdt.Color.Text.Primary">#F5F7FA</Color>
  <Color x:Key="Xdt.Color.Text.Secondary">#AEB7C2</Color>
  <Color x:Key="Xdt.Color.Accent">#107C10</Color>
  <Color x:Key="Xdt.Color.Accent.Hover">#149414</Color>
  <Color x:Key="Xdt.Color.Success">#3FB950</Color>
  <Color x:Key="Xdt.Color.Warning">#F2C94C</Color>
  <Color x:Key="Xdt.Color.Error">#EB5757</Color>
  <Color x:Key="Xdt.Color.Info">#209CEE</Color>
  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Xdt.Color.Background}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Xdt.Color.Surface}"/>
  <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource Xdt.Color.Elevated}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Xdt.Color.Border}"/>
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource Xdt.Color.Text.Primary}"/>
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource Xdt.Color.Text.Secondary}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Xdt.Color.Accent}"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource Xdt.Color.Accent.Hover}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Xdt.Color.Success}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Xdt.Color.Warning}"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Xdt.Color.Error}"/>
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Xdt.Color.Info}"/>
  <SolidColorBrush x:Key="Xdt.Brush.Accent.Subtle" Color="#153D20"/>
  <SolidColorBrush x:Key="Xdt.Brush.Info.Subtle" Color="#192638"/>
  <SolidColorBrush x:Key="Xdt.Brush.Warning.Subtle" Color="#332E19"/>
  <SolidColorBrush x:Key="Xdt.Brush.Error.Subtle" Color="#4A2024"/>
  <SolidColorBrush x:Key="Xdt.Brush.Hover" Color="#2A303A"/>
  <SolidColorBrush x:Key="Xdt.Brush.Overlay" Color="#D90F1115"/>
</ResourceDictionary>
